# Copy to .env and replace the placeholder before starting Docker Compose.
POSTGRES_USER=spacetime_node
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=spacetime_node

# Comma-separated browser origins. Keep empty for local curl-only use; set the
# exact HTTPS frontend origin in a deployed demo environment.
CORS_ALLOWED_ORIGINS=

# Keep the initial demo deterministic. A real provider is configured in a later sprint.
LLM_MODE=template
LLM_BASE_URL=
LLM_MODEL=

# Optional TRTC Beacon provider. Leave empty to use sanitized local fixtures.
BEACON_API_URL=
BEACON_API_USERNAME=
BEACON_API_PASSWORD=
BEACON_API_TIMEOUT_MS=800

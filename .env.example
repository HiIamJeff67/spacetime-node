# Copy to .env and replace the placeholder before starting Docker Compose.
POSTGRES_USER=spacetime_node
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=spacetime_node

# Comma-separated browser origins. Keep empty for local curl-only use; set the
# exact HTTPS frontend origin in a deployed demo environment.
CORS_ALLOWED_ORIGINS=

# Keep the initial demo deterministic. A real provider is configured in a later sprint.
LLM_MODE=template
LLM_BASE_URL=
LLM_MODEL=

# Embedding provider. Keep the self-contained hash fallback for the demo;
# semantic mode uses an OpenAI-compatible POST /v1/embeddings endpoint.
EMBEDDING_MODE=hash
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=demo-hash-v1
EMBEDDING_DIMENSION=32
EMBEDDING_COLLECTION=offer_embeddings_v1

# Maximum number of ranked eligible offers returned to the frontend.
RECOMMENDATION_CANDIDATE_LIMIT=10

# Notification provider. Keep mock for the deterministic demo; webpush sends
# encrypted browser notifications using the VAPID keys below.
NOTIFICATION_PROVIDER=mock
VAPID_SUBJECT=mailto:demo@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional TRTC Beacon provider. Leave empty to use sanitized local fixtures.
# Official endpoint: https://ws.metro.taipei/TRTCBeaconBE/BeaconControl.asmx/GetBeaconInfo
BEACON_API_URL=
BEACON_API_USERNAME=
BEACON_API_PASSWORD=
BEACON_API_TIMEOUT_MS=800

# Optional Gateway -> mobility service URL. Compose defaults this to the local
# mobility container; leave empty when running Gateway by itself.
MOBILITY_API_URL=
MOBILITY_API_TIMEOUT_MS=800
